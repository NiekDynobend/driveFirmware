# ------------------------------------------------------------------
# Host / simulation (CMake + MSVC, C/C++) - place in the project root
# ------------------------------------------------------------------

# CMake build folders (everything here is regenerated by
# "cmake -S . -B build" and "cmake --build build")
build/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json

# Visual Studio / MSVC generated files
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.suo
x64/
Debug/
Release/

# Compiled objects and binaries
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.pdb
*.ilk
*.idb
*.exp
*.tlog
*.log

# VS Code: keep shared settings, ignore personal/generated ones
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/ipch

# Editor / OS clutter
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
